  "item": [
    {
      "name": "Books",
      "item": [
        {
          "name": "Get All Books",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/books",
              "host": ["{{base_url}}"],
              "path": ["books"]
            }
          }
        },
        {
          "name": "Search Books",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/books?search=harry&kategori=fiksi&min_tahun=1990&max_tahun=2000",
              "host": ["{{base_url}}"],
              "path": ["books"],
              "query": [
                {
                  "key": "search",
                  "value": "harry"
                },
                {
                  "key": "kategori",
                  "value": "fiksi"
                },
                {
                  "key": "min_tahun",
                  "value": "1990"
                },
                {
                  "key": "max_tahun",
                  "value": "2000"
                }
              ]
            }
          }
        },
        {
          "name": "Get Book By ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/books/:id",
              "host": ["{{base_url}}"],
              "path": ["books", ":id"],
              "variable": [
                {
                  "key": "id",
                  "value": "YOUR_BOOK_ID"
                }
              ]
            }
          }
        },
