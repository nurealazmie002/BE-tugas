            "body": {
              "mode": "raw",
              "raw": "{\n  \"judul\": \"Harry Potter dan Batu Bertuah\",\n  \"penulis\": \"J.K. Rowling\",\n  \"penerbit\": \"Gramedia\",\n  \"tahun_terbit\": 1997,\n  \"kategori\": \"fiksi\",\n  \"stok\": 5\n}"
            },
            "url": {
              "raw": "{{base_url}}/books",
              "host": ["{{base_url}}"],
              "path": ["books"]
            }
          }
        },
        {
          "name": "Update Book",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"stok\": 10\n}"
            },
            "url": {
              "raw": "{{base_url}}/books/:id",
              "host": ["{{base_url}}"],
              "path": ["books", ":id"],
              "variable": [
                {
                  "key": "id",
                  "value": "YOUR_BOOK_ID"
                }
              ]
            }
          }
        },
        {
          "name": "Delete Book",
          "request": {
            "method": "DELETE",
            "header": [],
