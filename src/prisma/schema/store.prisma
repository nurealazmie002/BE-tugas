model Store {
  // Ubah Int menjadi String UUID agar sinkron dengan Product
  id          String    @id @default(uuid()) @db.Uuid
  name        String
  address     String?
  phone       String?
  email       String?   @unique
  description String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  products    Product[]

  @@map("stores")
}